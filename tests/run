#!/usr/bin/env bash
#
# Run all tests.

set -e

cd "$(dirname "$0")"

FAILED=0

for test in validate-structure.sh validate-install-guards.sh shellcheck.sh; do
  echo "━━━ $test ━━━"
  if bash "$test"; then
    echo ""
  else
    FAILED=$((FAILED + 1))
    echo ""
  fi
done

if [ "$FAILED" -gt 0 ]; then
  echo "✗ $FAILED test suite(s) failed"
  exit 1
else
  echo "✓ All test suites passed"
fi
